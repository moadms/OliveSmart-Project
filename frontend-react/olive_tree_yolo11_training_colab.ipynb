    "SAVE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "print(\"💾 Dossier de sauvegarde finale :\", SAVE_DIR)\n",
    "\n",
    "!pip install -q ultralytics opencv-python matplotlib seaborn pandas"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🧹 Section 1 — Fonctions Modulaires de Prétraitement (Clean Code)\n",
    "Regroupe toute la logique réutilisable :\n",
    "1. **`split_70_15_15(items)`** : séparation stricte avant tout découpage SAHI ou augmentation (0 fuite de données).\n",
    "2. **`apply_sahi_tiling(...)`** : découpe les grandes orthophotos en tuiles **`416×416`** avec **$25\\%$ de chevauchement (`stride=312`)** pour multiplier les exemples par $\sim 6\\times$ et doubler la taille apparente des petits oliviers.\n",
    "3. **`normalize_gray_world(img)`** : équilibre les couleurs pour rendre le Modèle Santé insensible aux écarts d'exposition entre Drone et Satellite."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from ultralytics import YOLO\n",
    "\n",
    "WORK_DIR = Path(\"/content/olive_3_pipelines\")\n",
    "RAW_EXTRACT = WORK_DIR / \"raw_extracted\"\n",
    "if WORK_DIR.exists(): shutil.rmtree(WORK_DIR)\n",
    "RAW_EXTRACT.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Téléchargement sur le SSD local /content/ (jamais sur Drive pour éviter le goulot I/O)\n",
    "ZIP_URL = \"https://raw.githubusercontent.com/moadms/OliveSmart-Project/main/datasets/atlas_oliva_hybrid_dataset.zip\"\n",
    "ZIP_PATH = WORK_DIR / \"atlas_oliva_hybrid_dataset.zip\"\n",
    "print(\"⬇️ Téléchargement du dataset sur le SSD local...\")\n",
    "urllib.request.urlretrieve(ZIP_URL, str(ZIP_PATH))\n",
    "with zipfile.ZipFile(ZIP_PATH, 'r') as zf:\n",
    "    zf.extractall(RAW_EXTRACT)\n",
    "\n",
    "def split_70_15_15(items, seed=42):\n",
    "    \"\"\"Split reproductible 70% Train / 15% Val / 15% Test avant toute transformation.\"\"\"\n",
    "    data = list(items)\n",
    "    random.seed(seed)\n",
    "    random.shuffle(data)\n",
    "    n = len(data)\n",
    "    n_tr = max(1, int(n * 0.70))\n",
    "    n_va = max(1, int(n * 0.15))\n",
    "    return {\n",
    "        \"train\": data[:n_tr],\n",
    "        \"val\": data[n_tr:n_tr + n_va],\n",
    "        \"test\": data[n_tr + n_va:] if n_tr + n_va < n else data[n_tr:n_tr + n_va]\n",
    "    }\n",
    "\n",
    "def normalize_gray_world(img_bgr):\n",
    "    \"\"\"Balance des blancs Gray-World : supprime le biais d'éclairage Drone vs Satellite.\"\"\"\n",
    "    f = img_bgr.astype(np.float32)\n",
    "    means = np.maximum(1.0, f.mean(axis=(0, 1)))\n",
    "    avg = float(means.mean())\n",
    "    f = np.clip(f * (avg / means), 0, 255)\n",
    "    return f.astype(np.uint8)\n",
    "\n",
    "def build_sahi_yolo_dataset(pairs, out_dir: Path, tile_size=416, stride=312):\n",
    "    \"\"\"Applique le split 70/15/15 puis découpe en tuiles SAHI 416x416 (zéro fuite de données).\"\"\"\n",
    "    for sp in [\"train\", \"val\", \"test\"]:\n",
    "        (out_dir / sp / \"images\").mkdir(parents=True, exist_ok=True)\n",
    "        (out_dir / sp / \"labels\").mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    splits = split_70_15_15(pairs)\n",
    "    counts = {}\n",
    "\n",
    "    for sp, items in splits.items():\n",
    "        t_idx = 0\n",
    "        for img_p, lbl_p in items:\n",
    "            img = cv2.imread(str(img_p))\n",
    "            if img is None: continue\n",
    "            H, W = img.shape[:2]\n",
    "\n",
    "            # Lecture des boîtes en pixels absolus\n",
    "            boxes = []\n",
    "            for line in lbl_p.read_text().splitlines():\n",
    "                parts = line.split()\n",
    "                if len(parts) >= 5:\n",
    "                    xc, yc, bw, bh = map(float, parts[1:5])\n",
    "                    boxes.append((xc * W, yc * H, bw * W, bh * H))\n",
    "\n",
    "            # Si l'image est petite (<= tile_size), on la garde entière, sinon découpage SAHI\n",
    "            y_starts = [0] if H <= tile_size else list(range(0, H - tile_size + 1, stride)) + [H - tile_size]\n",
    "            x_starts = [0] if W <= tile_size else list(range(0, W - tile_size + 1, stride)) + [W - tile_size]\n",
    "            coords = sorted(set((x, y) for y in y_starts for x in x_starts))\n",
    "\n",
    "            for x0, y0 in coords:\n",
    "                x1_crop, y1_crop = min(W, x0 + tile_size), min(H, y0 + tile_size)\n",
    "                sub = img[y0:y1_crop, x0:x1_crop]\n",
    "                sh, sw = sub.shape[:2]\n",
    "                if sh < tile_size or sw < tile_size:\n",
    "                    pad = np.zeros((tile_size, tile_size, 3), dtype=np.uint8)\n",
    "                    pad[:sh, :sw] = sub\n",
    "                    sub = pad\n",
    "\n",
    "                tile_lbls = []\n",
    "                for bx, by, bw, bh in boxes:\n",
    "                    if x0 <= bx < x0 + sw and y0 <= by < y0 + sh:\n",
    "                        nxc = (bx - x0) / tile_size\n",
    "                        nyc = (by - y0) / tile_size\n",
    "                        nbw = min(1.0, bw / tile_size)\n",
    "                        nbh = min(1.0, bh / tile_size)\n",
    "                        if nbw > 0.01 and nbh > 0.01:\n",
    "                            tile_lbls.append(f\"0 {nxc:.6f} {nyc:.6f} {nbw:.6f} {nbh:.6f}\")\n",
    "\n",
    "                if tile_lbls:\n",
    "                    cv2.imwrite(str(out_dir / sp / \"images\" / f\"{sp}_{t_idx:05d}.jpg\"), sub)\n",
    "                    (out_dir / sp / \"labels\" / f\"{sp}_{t_idx:05d}.txt\").write_text(\"\\n\".join(tile_lbls))\n",
    "                    t_idx += 1\n",
    "        counts[sp] = t_idx\n",
    "\n",
    "    (out_dir / \"data.yaml\").write_text(\n",
    "        f\"path: {out_dir.as_posix()}\\ntrain: train/images\\nval: val/images\\ntest: test/images\\nnc: 1\\nnames:\\n  0: Olive_Tree\\n\"\n",
    "    )\n",
    "    return counts\n",
    "\n",
    "# Séparation stricte des 2 sources : Satellite vs Drone\n",
    "all_imgs = sorted((RAW_EXTRACT / \"images\").glob(\"*\"))\n",
    "sat_pairs = [(p, RAW_EXTRACT / \"labels\" / f\"{p.stem}.txt\") for p in all_imgs if p.name.startswith(\"sat_\") and (RAW_EXTRACT / \"labels\" / f\"{p.stem}.txt\").exists()]\n",
    "drone_pairs = [(p, RAW_EXTRACT / \"labels\" / f\"{p.stem}.txt\") for p in all_imgs if p.name.startswith(\"drone_\") and (RAW_EXTRACT / \"labels\" / f\"{p.stem}.txt\").exists()]\n",
    "\n",
    "SAT_DIR = WORK_DIR / \"dataset_satellite_416\"\n",
    "DRONE_DIR = WORK_DIR / \"dataset_drone_416\"\n",
    "\n",
    "sat_counts = build_sahi_yolo_dataset(sat_pairs, SAT_DIR, tile_size=416, stride=312)\n",
    "drone_counts = build_sahi_yolo_dataset(drone_pairs, DRONE_DIR, tile_size=416, stride=312)\n",
    "\n",
    "print(f\"🛰️ Dataset SATELLITE SAHI 416px : {sat_counts} (à partir de {len(sat_pairs)} grandes tuiles)\")\n",
    "print(f\"🛩️ Dataset DRONE SAHI 416px     : {drone_counts} (à partir de {len(drone_pairs)} grandes orthos)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📊 Section 2 — Fonction d'Évaluation & Diagnostic Automatique (« Comment Corriger »)\n",
    "Évalue chaque modèle sur son **Test Set (15%)** et génère automatiquement des recommandations concrètes selon les scores obtenus :"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_and_diagnose_detector(weights_path: Path, data_yaml: Path, title: str):\n",
    "    \"\"\"Évalue sur le Test Set et fournit un diagnostic actionnable.\"\"\"\n",
    "    model = YOLO(str(weights_path))\n",
    "    m = model.val(data=str(data_yaml), split=\"test\", imgsz=416, plots=True, verbose=False)\n",
    "    p, r, map50, map95 = float(m.box.mp), float(m.box.mr), float(m.box.map50), float(m.box.map)\n",
    "    f1 = (2 * p * r / (p + r)) if (p + r) > 0 else 0.0\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 68)\n",
    "    print(f\"📊 RÉSULTATS TEST SET — {title}\")\n",
    "    print(\"=\" * 68)\n",
    "    print(f\"   • Précision (P) : {p*100:.2f}%  |  Rappel (R) : {r*100:.2f}%  |  F1 : {f1*100:.2f}%\")\n",
    "    print(f\"   • mAP@50        : {map50*100:.2f}%  |  mAP@50-95  : {map95*100:.2f}%\")\n",
    "    print(\"\\n🩺 DIAGNOSTIC & COMMENT CORRIGER :\")\n",
    "    if r < 0.85:\n",
    "        print(\"   ⚠️ Rappel < 85% (arbres manqués) -> Réduire tile_size à 320px ou baisser conf=0.15 et augmenter copy_paste=0.3.\")\n",
    "    if p < 0.85:\n",
    "        print(\"   ⚠️ Précision < 85% (faux positifs) -> Ajouter 10% d'images de sol nu/routes (labels vides) et monter conf=0.25.\")\n",
    "    if map50 >= 0.85 and map95 < 0.45:\n",
    "        print(\"   ℹ️ mAP@50 bon mais mAP@50-95 perfectible -> Augmenter close_mosaic=20 pour affiner le centrage des boîtes.\")\n",
    "    if p >= 0.88 and r >= 0.88 and map50 >= 0.90:\n",
    "        print(\"   ✅ Modèle optimal prêt pour la production !\")\n",
    "    print(\"=\" * 68)\n",
    "    return {\"P\": p, \"R\": r, \"F1\": f1, \"mAP50\": map50, \"mAP95\": map95}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🛰️ Section 3 — PIPELINE 1 : Entraînement Spécialisé SATELLITE (`best_yolo11s_satellite.pt`)\n",
    "- **Optimisé Colab :** `cache=True` (RAM), `amp=True` (FP16), `cos_lr=True`, `AdamW`, **`80 époques`** (`patience=20`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sat_model = YOLO(\"yolo11s.pt\")\n",
    "sat_model.train(\n",
    "    data=str(SAT_DIR / \"data.yaml\"),\n",
    "    epochs=80,\n",
    "    patience=20,\n",
    "    imgsz=416,\n",
    "    batch=32,\n",
    "    device=0,\n",
    "    cache=True,\n",
    "    amp=True,\n",
    "    optimizer=\"AdamW\",\n",
    "    lr0=0.001,\n",
    "    cos_lr=True,\n",
    "    close_mosaic=15,\n",
    "    scale=0.5,\n",
    "    copy_paste=0.2,\n",
    "    fliplr=0.5,\n",
    "    flipud=0.5,\n",
    "    project=str(WORK_DIR / \"runs\"),\n",
    "    name=\"sat_416\",\n",
    "    exist_ok=True\n",
    ")\n",
    "best_sat = WORK_DIR / \"runs/sat_416/weights/best.pt\"\n",
    "shutil.copy2(best_sat, SAVE_DIR / \"best_yolo11s_satellite.pt\")\n",
    "evaluate_and_diagnose_detector(best_sat, SAT_DIR / \"data.yaml\", \"MODÈLE 1 — SATELLITE (Leaflet)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🛩️ Section 4 — PIPELINE 2 : Entraînement Spécialisé DRONE / UAV (`best_yolo11s_drone.pt`)\n",
    "- **Optimisé Colab :** `cache=True`, `amp=True`, rotations zénithales `degrees=15.0`, **`80 époques`** (`patience=20`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "drone_model = YOLO(\"yolo11s.pt\")\n",
    "drone_model.train(\n",
    "    data=str(DRONE_DIR / \"data.yaml\"),\n",
    "    epochs=80,\n",
    "    patience=20,\n",
    "    imgsz=416,\n",
    "    batch=32,\n",
    "    device=0,\n",
    "    cache=True,\n",
    "    amp=True,\n",
    "    optimizer=\"AdamW\",\n",
    "    lr0=0.001,\n",
    "    cos_lr=True,\n",
    "    close_mosaic=15,\n",
    "    scale=0.5,\n",
    "    copy_paste=0.2,\n",
    "    degrees=15.0,\n",
    "    fliplr=0.5,\n",
    "    flipud=0.5,\n",
    "    project=str(WORK_DIR / \"runs\"),\n",
    "    name=\"drone_416\",\n",
    "    exist_ok=True\n",
    ")\n",
    "best_drone = WORK_DIR / \"runs/drone_416/weights/best.pt\"\n",
    "shutil.copy2(best_drone, SAVE_DIR / \"best_yolo11s_drone.pt\")\n",
    "evaluate_and_diagnose_detector(best_drone, DRONE_DIR / \"data.yaml\", \"MODÈLE 2 — DRONE UAV\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🩺 Section 5 — PIPELINE 3 : Prétraitement & Entraînement SANTÉ (`sain` / `stress` / `suspect`)\n",
    "- **Zéro biais d'éclairage :** Chaque grande image passe d'abord par **`normalize_gray_world()`** avant le découpage des couronnes.\n",
    "- **Indices combinés :** $ExG$ + $VARI = \\frac{G - R}{G + R - B}$ + $GCC$.\n",
    "- **Zéro fuite de données :** Split 70/15/15 sur les images sources avant d'extraire les couronnes, puis rééquilibrage **uniquement dans Train** + `ColorJitter` (`hsv_h=0.02`, `hsv_s=0.7`, `hsv_v=0.5`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "HEALTH_DIR = WORK_DIR / \"dataset_health_balanced\"\n",
    "for sp in [\"train\", \"val\", \"test\"]:\n",
    "    for cls in [\"sain\", \"stress\", \"suspect\"]:\n",
    "        (HEALTH_DIR / sp / cls).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "all_splits = split_70_15_15(sat_pairs + drone_pairs)\n",
    "crops_by_split = {sp: {\"sain\": [], \"stress\": [], \"suspect\": []} for sp in [\"train\", \"val\", \"test\"]}\n",
    "\n",
    "for sp, items in all_splits.items():\n",
    "    for img_p, lbl_p in items:\n",
    "        img = cv2.imread(str(img_p))\n",
    "        if img is None: continue\n",
    "        img_gw = normalize_gray_world(img)\n",
    "        H, W = img_gw.shape[:2]\n",
    "        for line in lbl_p.read_text().splitlines():\n",
    "            parts = line.split()\n",
    "            if len(parts) < 5: continue\n",
    "            xc, yc, bw, bh = map(float, parts[1:5])\n",
    "            x1, y1 = max(0, int((xc - bw/2)*W)), max(0, int((yc - bh/2)*H))\n",
    "            x2, y2 = min(W, int((xc + bw/2)*W)), min(H, int((yc + bh/2)*H))\n",
    "            crop = img_gw[y1:y2, x1:x2]\n",
    "            if crop.shape[0] < 16 or crop.shape[1] < 16: continue\n",
    "\n",
    "            ch, cw = crop.shape[:2]\n",
    "            core = crop[ch//4:3*ch//4, cw//4:3*cw//4]\n",
    "            if core.size == 0: core = crop\n",
    "            rgb = cv2.cvtColor(core, cv2.COLOR_BGR2RGB).astype(np.float32)\n",
    "            R, G, B = rgb[:,:,0], rgb[:,:,1], rgb[:,:,2]\n",
    "            exg = float(np.mean(2.0 * G - R - B))\n",
    "            gcc = float(np.mean(G / (R + G + B + 1e-6)))\n",
    "            vari = float(np.mean((G - R) / np.maximum(1.0, G + R - B)))\n",
    "\n",
    "            if exg >= 8.5 and gcc >= 0.348 and vari >= 0.01:\n",
    "                cls = \"sain\"\n",
    "            elif exg >= 1.5 and gcc >= 0.318:\n",
    "                cls = \"stress\"\n",
    "            else:\n",
    "                cls = \"suspect\"\n",
    "            if sp == \"train\" and cls == \"sain\" and len(crops_by_split[sp][cls]) >= 1800:\n",
    "                continue\n",
    "            crops_by_split[sp][cls].append(cv2.resize(crop, (128, 128)))\n",
    "\n",
    "# Rééquilibrage strict uniquement dans Train\n",
    "target_tr = max(len(v) for v in crops_by_split[\"train\"].values())\n",
    "for cls in [\"sain\", \"stress\", \"suspect\"]:\n",
    "    base = crops_by_split[\"train\"][cls]\n",
    "    if not base: continue\n",
    "    orig = len(base)\n",
    "    k = 0\n",
    "    while len(base) < target_tr:\n",
    "        aug = cv2.rotate(cv2.flip(base[k % orig], k % 2), [cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k % 3])\n",
    "        base.append(aug)\n",
    "        k += 1\n",
    "\n",
    "for sp in [\"train\", \"val\", \"test\"]:\n",
    "    for cls in [\"sain\", \"stress\", \"suspect\"]:\n",
    "        for i, c in enumerate(crops_by_split[sp][cls]):\n",
    "            cv2.imwrite(str(HEALTH_DIR / sp / cls / f\"{cls}_{i:05d}.jpg\"), c)\n",
    "\n",
    "health_model = YOLO(\"yolo11s-cls.pt\")\n",
    "health_model.train(\n",
    "    data=str(HEALTH_DIR),\n",
    "    epochs=50,\n",
    "    patience=15,\n",
    "    imgsz=128,\n",
    "    batch=64,\n",
    "    device=0,\n",
    "    cache=True,\n",
    "    amp=True,\n",
    "    optimizer=\"AdamW\",\n",
    "    lr0=0.001,\n",
    "    cos_lr=True,\n",
    "    fliplr=0.5,\n",
    "    flipud=0.5,\n",
    "    hsv_h=0.02,\n",
    "    hsv_s=0.7,\n",
    "    hsv_v=0.5,\n",
    "    erasing=0.2,\n",
    "    plots=True,\n",
    "    project=str(WORK_DIR / \"runs\"),\n",
    "    name=\"health_cls\",\n",
    "    exist_ok=True\n",
    ")\n",
